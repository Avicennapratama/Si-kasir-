# ============================================================
# SiKasir AI — Frontend (Next.js) environment
# ------------------------------------------------------------
# Copy file ini jadi `.env` lalu isi dengan nilai ASLI.
#   cp .env.example .env
#
# CATATAN PENTING:
# - Semua var NEXT_PUBLIC_* IKUT TER-BUNDLE KE BROWSER.
#   Jangan pernah menaruh secret (Gemini key, service account,
#   private key) dengan prefix NEXT_PUBLIC_.
# - Key AI (GEMINI_API_KEY) ada di `functions/.env`, BUKAN di sini.
# - Restart `npm run dev` setiap kali file .env berubah.
#   Next.js hanya membaca env saat startup.
# ============================================================

# --- Firebase Web SDK ------------------------------------------------
# Ambil di: Firebase Console > Project Settings (ikon gerigi)
#           > General > Your apps > Web app > SDK setup and configuration
#           > pilih "Config"
# Kalau belum ada Web app, klik "Add app" > Web (ikon </>).
#
# Nilai-nilai ini memang tidak rahasia (didesain untuk publik).
# Yang mengamankan data kamu adalah Firestore Rules + Storage Rules,
# bukan kerahasiaan key ini.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Base URL API (Firebase Functions) -------------------------------
# PENTING: backend proyek ini adalah Firebase Functions, BUKAN Next.js
# API routes (folder app/api memang kosong).
#
# Emulator lokal  : http://localhost:5001/<project-id>/us-central1/api
# Produksi        : https://us-central1-<project-id>.cloudfunctions.net/api
NEXT_PUBLIC_API_BASE_URL=http://localhost:5001/sikasir-ai/us-central1/api

# Fallback lama — dipakai hanya kalau NEXT_PUBLIC_API_BASE_URL kosong.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

