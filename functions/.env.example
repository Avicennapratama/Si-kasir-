# ============================================================
# SiKasir AI — Backend (Firebase Functions) environment
# ------------------------------------------------------------
# Copy jadi `functions/.env` lalu isi nilai asli:
#   cp functions/.env.example functions/.env
#
# File ini SERVER-SIDE. Aman untuk secret — tidak pernah
# terkirim ke browser. JANGAN pindahkan GEMINI_API_KEY ke
# .env root dengan prefix NEXT_PUBLIC_.
#
# Produksi: pakai Google Secret Manager, bukan file .env
# (lihat docs/TECH_SPEC.md bagian 14.3 Secret Management).
# ============================================================

# --- Gemini API ------------------------------------------------------
# Ambil gratis di: https://aistudio.google.com/apikey
# Dipakai oleh: functions/src/config/gemini.ts
#               functions/src/config/env.ts
#               functions/src/ai/geminiClient.ts
GEMINI_API_KEY=

# --- Vertex AI (opsional) --------------------------------------------
# Hanya perlu kalau ENABLE_VERTEX_AI=true.
# Untuk sekarang biarkan kosong — Gemini API sudah cukup.
VERTEX_AI_PROJECT=
VERTEX_AI_LOCATION=us-central1
ENABLE_VERTEX_AI=false

# --- Firebase --------------------------------------------------------
# Samakan dengan NEXT_PUBLIC_FIREBASE_PROJECT_ID di .env root.
FIREBASE_PROJECT_ID=

# --- Rate limiting (punya default di config/env.ts) ------------------
DEFAULT_RATE_LIMIT=100
UPLOAD_RATE_LIMIT=10

# --- Upload limits ---------------------------------------------------
MAX_UPLOAD_SIZE=5242880
ALLOWED_MIME_TYPES=image/*,application/pdf

# --- Feature flags ---------------------------------------------------
ENABLE_ANALYTICS=true
