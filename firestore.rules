rules_version = '2';

service cloud.firestore {

  // ============================================================
  // CATATAN ARSITEKTUR
  // ------------------------------------------------------------
  // Backend (Firebase Functions / Admin SDK) TIDAK terikat rules ini —
  // Admin SDK selalu bypass. Rules ini hanya mengatur akses LANGSUNG
  // dari browser (frontend) ke Firestore.
  //
  // Frontend hanya menyentuh:
  //   - users/{uid}            (auth-context.tsx: getDoc/setDoc profil)
  //   - businesses/biz_{uid}   (auth-context.tsx: profil usaha)
  // Selebihnya lewat API backend. Tapi subcollection tetap didefinisikan
  // untuk kedepannya, dengan nama yang SAMA dengan backend (camelCase):
  //   transactions, drafts, assistantChats, config, gamification,
  //   hkiValuations, mediaAssets, studioAssets, usage
  // ============================================================

  // --- User profile ---
  match /users/{userId} {
    // Hanya user itu sendiri yang boleh baca/tulis profilnya.
    // Dipakai auth-context.tsx saat login Google pertama (setDoc profil).
    allow read, create, update: if request.auth != null
      && request.auth.uid == userId;

    // delete ditutup: penghapusan akun lewat backend.
    allow delete: if false;
  }

  // --- Business + seluruh subcollection-nya ---
  match /businesses/{businessId} {
    // Owner dicek dari field `ownerId` di dokumen business itu sendiri
    // (diisi auth-context.tsx: ownerId: user.uid). Tidak perlu get() tambahan.
    function isOwner() {
      return request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    allow read, update, delete: if isOwner();

    // Saat create, ownerId WAJIB sama dengan uid yang login.
    allow create: if request.auth != null
      && request.resource.data.ownerId == request.auth.uid;

    // ----- Subcollections (nama = persis seperti di functions/src) -----

    match /transactions/{transactionId} {
      allow read, update, delete: if isOwner();
      allow create: if isOwner()
        && request.resource.data.businessId == businessId;
    }

    match /drafts/{draftId} {
      allow read, create, update, delete: if isOwner();
    }

    match /assistantChats/{chatId} {
      allow read, create, update, delete: if isOwner();
    }

    match /gamification/{docId} {
      allow read, create, update: if isOwner();
      allow delete: if false; // riwayat gamifikasi tidak boleh dihapus klien
    }

    match /hkiValuations/{valuationId} {
      allow read, create: if isOwner();
      allow update, delete: if false; // valuasi bersifat append-only
    }

    match /mediaAssets/{assetId} {
      allow read, create, update, delete: if isOwner();
    }

    match /studioAssets/{assetId} {
      allow read, create, update, delete: if isOwner();
    }

    match /usage/{docId} {
      allow read, create, update: if isOwner();
      allow delete: if false; // kuota pemakaian tidak boleh direset klien
    }

    match /config/{configKey} {
      allow read, create, update: if isOwner();
      allow delete: if false;
    }
  }

  // --- Semua yang lain: tolak ---
  match /{document=**} {
    allow read, write: if false;
  }
}