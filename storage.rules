rules_version = "2";

service sikasir-ai.firebaseapp.com {

  match /databases/$(databases)/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /transactions/{transactionId} {
      allow read: if request.auth != null && request.auth.uid != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == request.resource.data.userId;
      allow delete: if false;
    }

    match /categories/{categoryId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }

    match /settings/{docId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == request.resource.data.userId;
    }
  }
}